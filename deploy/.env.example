# 新平食品 P1 · 环境变量说明
# 复制成 .env 后按需改；docker compose 会自动读取同目录的 .env

# ---- 必改 ----
# dev = 演示模式（开 reset/demo 接口，方便试）；prod = 生产模式（关掉这些接口）
P1_ENV=prod

# 数据目录：数据库 p1.db、打卡照片、签名密钥都在这里。备份就备份这个目录。
P1_DATA=/data

# ---- 网络 ----
# prod 默认 0.0.0.0；如果前面有 Nginx，建议改成 127.0.0.1 只给本机访问
P1_HOST=127.0.0.1
P1_PORT=8765

# ---- 可选 ----
# 商品目录表路径（默认读项目里的中文名文件；Docker 镜像里指向 /app/catalog.xlsx）
# P1_XLSX=/app/catalog.xlsx

# ---- 注意 ----
# 密钥不放这里：首次启动会在 $P1_DATA/.secret 生成并持久化，删了等于所有人被登出。
# 别把它提交进 git。
