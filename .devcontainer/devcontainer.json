{
  "name": "新平食品 P1",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "P1 应用",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },
  "postCreateCommand": "pip install --user openpyxl==3.1.5",
  "postStartCommand": "bash deploy/codespaces-start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.analysis.typeCheckingMode": "off"
      }
    }
  }
}
